# BizPilot AI Enterprise Environment Configuration

# Environment (development / staging / production)
ENVIRONMENT=development

# Database Connection URL format:
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/bizpilot

# JWT Secret Key (DO NOT use default secret in production)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Raw Storage Directory
RAW_STORAGE_DIR=storage/raw

# Max Upload Limit (MB)
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting Limits
RATE_LIMIT_PER_MINUTE=300

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
